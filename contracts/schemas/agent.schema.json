{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-agent-ecosystem/agent.schema.json",
  "title": "Agent Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "module",
    "name",
    "mission",
    "responsibilities",
    "boundaries",
    "outputs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "mission": {
      "type": "string",
      "minLength": 10
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools_policy": {
      "type": "string"
    },
    "module": {
      "type": "string"
    }
  }
}
