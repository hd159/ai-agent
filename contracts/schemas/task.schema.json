{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-agent-ecosystem/task.schema.json",
  "title": "Agent Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "title",
    "owner",
    "objective",
    "inputs",
    "scope",
    "out_of_scope",
    "dependencies",
    "owned_paths",
    "acceptance_criteria",
    "verification",
    "status"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "owner": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owned_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "status": {
      "enum": [
        "pending",
        "blocked",
        "ready_for_dispatch",
        "dispatched",
        "in_progress",
        "in_review",
        "completed",
        "failed"
      ]
    },
    "completion_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
