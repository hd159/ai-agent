{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent Task Verification Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "implementation_agent",
    "reviewer_agent",
    "reviewed_at",
    "review_status",
    "source_commit",
    "checks",
    "acceptance_results"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
    },
    "implementation_agent": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_agent": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_status": {
      "enum": [
        "approved",
        "changes_requested",
        "blocked"
      ]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "result",
          "executed_at",
          "evidence_paths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "test",
              "build",
              "integration",
              "security",
              "inspection"
            ]
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "executed_at": {
            "type": "string",
            "format": "date-time"
          },
          "environment": {
            "type": "string"
          },
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "acceptance_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "result",
          "check_ids"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run"
            ]
          },
          "check_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
