{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-agent-ecosystem/execution-state.schema.json",
  "title": "Execution State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "team_id",
    "status",
    "updated_at",
    "last_checkpoint_at",
    "tasks"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "project_id": { "type": "string" },
    "team_id": { "type": "string" },
    "status": {
      "enum": [
        "planning",
        "awaiting_approval",
        "ready_for_dispatch",
        "in_progress",
        "blocked",
        "in_review",
        "completed"
      ]
    },
    "current_phase": { "type": ["string", "null"] },
    "current_focus": { "type": ["string", "null"] },
    "updated_at": { "type": "string", "format": "date-time" },
    "last_checkpoint_at": { "type": "string", "format": "date-time" },
    "last_session_id": { "type": ["string", "null"] },
    "source_commit": { "type": ["string", "null"] },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pending_decisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "status"],
        "properties": {
          "task_id": { "type": "string" },
          "status": {
            "enum": [
              "pending",
              "blocked",
              "ready_for_dispatch",
              "dispatched",
              "in_progress",
              "in_review",
              "completed",
              "failed"
            ]
          },
          "owner": { "type": ["string", "null"] },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "blockers": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
