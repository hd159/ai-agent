{
  "schema_version": "1.0.0",
  "platform": "Google Antigravity",
  "purpose": "Explicit least-privilege built-in tool allowlists for the bundled custom agents.",
  "references": [
    "https://antigravity.google/docs/subagents",
    "https://antigravity.google/docs/build-plugins",
    "https://antigravity.google/docs/hooks"
  ],
  "allowed_tools": [
    "find_by_name",
    "grep_search",
    "invoke_subagent",
    "list_dir",
    "manage_subagents",
    "multi_replace_file_content",
    "read_url_content",
    "replace_file_content",
    "run_command",
    "search_web",
    "send_message",
    "view_file",
    "write_to_file"
  ],
